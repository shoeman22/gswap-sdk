{
  "name": "@gala-chain/gswap-sdk",
  "version": "1.0.0-rc.1",
  "description": "A source development kit for interacting with GSwap.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "mocha --spec tests/**/*.test.ts",
    "test:live": "TS_NODE_FILES=true mocha --timeout 300000 --spec 'tests/live/**/*.live.ts'",
    "test:cov": "c8 --reporter=text-summary --reporter=json-summary --all --src src --include 'src/**/*.ts' --exclude 'src/types/**' mocha --spec 'tests/**/*.test.ts'",
    "test:debug:nospec": "node -r  ts-node/register node_modules/.bin/mocha --exit --timeout 120000",
    "lint": "eslint src tests examples/cli/src --ext .ts,.js --max-warnings=0",
    "lint:fix": "eslint src tests examples/cli/src --ext .ts,.js --fix",
    "prepare": "husky",
    "build": "tsup",
    "build:node": "tsup --config tsup.config.ts --name node",
    "build:browser": "tsup --config tsup.config.ts --name browser",
    "build:dev": "tsup --watch",
    "build:legacy": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "coverage:goal": "tsx scripts/check-coverage-threshold.ts",
    "check:coverage:goal": "npm run test:cov && npm run coverage:goal",
    "check:clones": "jscpd src tests --min-lines 12 --min-tokens 70 --threshold 0 --reporters console",
    "check:strict": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run check:clones",
    "check:all": "npm run check:strict && npm run check:coverage:goal && npm run build && npm run check:examples && npm run check:pack",
    "check:examples": "tsx scripts/check-examples.ts",
    "check:pack": "tsx scripts/packed-smoke.ts",
    "clean": "rm -rf dist",
    "docs:build": "cd docs && npm run generate-typedoc && npm run build",
    "docs:dev": "cd docs && npm run start",
    "docs:serve": "cd docs && npm run serve",
    "docs:deploy": "cd docs && npm run deploy",
    "builddocs": "npm run docs:build"
  },
  "keywords": [
    "dex",
    "gala",
    "galaswap",
    "sdk"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.12",
    "@types/fetch-mock": "^7.3.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.1",
    "buffer": "^6.0.3",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.1",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "events": "^3.3.0",
    "fetch-mock": "^12.5.3",
    "global": "^4.4.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jscpd": "^5.1.2",
    "lint-staged": "^16.1.0",
    "mocha": "^11.7.1",
    "prettier": "^3.5.3",
    "stream": "^0.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.ts": "prettier --write"
  },
  "dependencies": {
    "@gala-chain/api": "2.3.2",
    "@gala-chain/connect": "2.3.2",
    "bignumber.js": "^9.3.0",
    "debug": "^4.4.1",
    "decimal.js": "^10.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "bn.js": "^5.2.3",
    "validator": "^13.15.22",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  }
}
